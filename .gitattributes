# Keep line endings sane on a Windows team that ships Linux containers.
# Files that run *inside* containers must be LF or they break at runtime.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.dockerfile text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.env       text eol=lf
# Everything else: let git normalize, checkout native.
* text=auto
