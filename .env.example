# AegisMesh environment template. Copy to .env and adjust. Never commit the real .env.
# (Phase 8 finalizes this; entries are added as each service introduces them.)

# ---- OpenTelemetry (all services) ----
# Where spans/metrics/logs are sent. Local SigNoz ingester speaks plaintext gRPC on 4317.
# On the host use localhost; inside a container use the collector's reachable address.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Resource attributes attached to every signal.
SERVICE_VERSION=0.1.0
DEPLOYMENT_ENV=hackathon
# How often metrics are exported (ms). Short so they show up quickly in the demo.
OTEL_METRIC_EXPORT_INTERVAL_MS=10000

# ---- ai-inference-service (:8003) ----
# OTEL_SERVICE_NAME is set per-service; this is its value.
OTEL_SERVICE_NAME=ai-inference-service
MODEL_NAME=aegis-sim-1
# Baseline simulated inference latency in ms (Phase 7 chaos inflates this at runtime).
INFER_BASE_LATENCY_MS=150

# ---- api-gateway (:8001) ----
OTEL_SERVICE_NAME=api-gateway            # (set per-service; value shown for this one)
WORKER_QUEUE_URL=http://localhost:8002
# The gateway returns HTTP 504 if the downstream exceeds this budget.
GATEWAY_TIMEOUT_MS=5000

# ---- worker-queue (:8002) ----
OTEL_SERVICE_NAME=worker-queue           # (set per-service; value shown for this one)
AI_INFERENCE_URL=http://localhost:8003
# Bounded concurrency pool. Small on purpose; the AI controller raises it to fix Fault A.
MAX_WORKER_CONCURRENCY=5
# Retry-with-backoff on downstream 429/5xx/errors; retries KEEP holding the pool slot.
MAX_RETRIES=2
RETRY_BACKOFF_MS=200
DOWNSTREAM_TIMEOUT_MS=10000
# Fault-B remediation knobs (behaviour wired in Phase 7; accepted by /admin/config now).
LLM_SAMPLING_RATE=1.0
FALLBACK_ROUTING=false

# ---- load-generator ----
TARGET_URL=http://localhost:8001/v1/generate
CONCURRENCY=15                 # in-flight requests; 10-20 is the intended band
THINK_TIME_MS=0                # per-worker jittered pause between requests (0 = flat out)
LOADGEN_MAX_TOKENS=64
LOADGEN_DURATION_S=0           # 0 = run forever
LOADGEN_TIMEOUT_S=20           # MUST exceed the gateway's 5s budget to record 504s
REPORT_EVERY_S=5

# ---- SigNoz MCP server (:8000, used by the AI controller / team lead) ----
# The MCP container runs without a key by default; it needs an API key generated in the
# SigNoz UI (Settings -> API Keys) to actually query telemetry. Inject it here, do NOT
# hardcode it in casting.yaml or commit it.
# SIGNOZ_API_KEY=
